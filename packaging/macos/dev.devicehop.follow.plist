<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Untested template. Install:
    cp dev.devicehop.follow.plist ~/Library/LaunchAgents/
    (edit the devicehop path and REPLACE_WITH_TARGET: a host number, host name or name=N)
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.devicehop.follow.plist
  When run by launchd, the devicehop binary itself must be added to
  System Settings -> Privacy & Security -> Input Monitoring.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.devicehop.follow</string>
    <key>ProgramArguments</key>
    <array>
        <string>/REPLACE/WITH/PATH/devicehop</string>
        <string>follow</string>
        <string>REPLACE_WITH_TARGET</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/devicehop-follow.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/devicehop-follow.log</string>
</dict>
</plist>
